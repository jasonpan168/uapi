DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uapi_db
DB_USER=root
DB_PASS=
APP_USER=uapi
APP_PASS=
INSTALL_SECRET=

# Realtime derived address service (per-order address)
DERIVED_ADDR_SERVICE_URL=http://127.0.0.1:8787
DERIVED_ADDR_SERVICE_TOKEN=change_this_token
DERIVED_ADDR_SERVICE_TIMEOUT=5

# Email notifications (optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=UAPI

# Payment provider credentials are NOT read from this file.
# They live in the `system_settings` table and are edited in the admin panel
# (Admin → Settings → Payment). Keys you will need:
#   stripe_public_key           pk_...
#   stripe_secret_key           sk_...
#   stripe_webhook_secret       whsec_...  (REQUIRED for /api/v1/stripe/webhook.php)
#   binance_pay_api_key / binance_pay_api_secret / binance_pay_webhook_secret
# The Stripe webhook endpoint answers 503 and processes nothing until
# stripe_webhook_secret is set, so unsigned/forged events can never be accepted.
